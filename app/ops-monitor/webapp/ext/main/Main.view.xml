<mvc:View
  xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.f"
  xmlns:viz="sap.viz.ui5.controls" xmlns:vizData="sap.viz.ui5.data" xmlns:vizFeeds="sap.viz.ui5.controls.common.feeds"
  controllerName="ops.monitor.ext.main.Main">

  <f:DynamicPage id="page" headerExpanded="true" showFooter="false" fitContent="false" class="opsPage">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading><Title text="Operations Monitor" level="H2"/></f:heading>
        <f:expandedContent>
          <Text text="IDoc Monitor + Job Failure Monitor · Source: SAP Cloud ALM via each monitor's own sync"/>
        </f:expandedContent>
        <f:snappedContent>
          <Text text="{ui>/overview/error} failures · IDocs {ui>/overview/idocErrors} · Jobs {ui>/overview/jobErrors}"/>
        </f:snappedContent>
        <f:actions>
          <HBox items="{ui>/overview/sources}" class="sapUiSmallMarginEnd">
            <ObjectStatus class="sapUiTinyMarginEnd"
              text="{ui>label}: {= ${ui>available} ? (${ui>lastSyncAt} ? 'synced ' + ${ui>lastSyncText} : 'no sync yet') : 'unavailable'}"
              state="{= !${ui>available} || ${ui>lastSyncOk} === false ? 'Error' : 'Success'}"
              icon="{= !${ui>available} ? 'sap-icon://disconnected' : 'sap-icon://synchronize'}"
              tooltip="{= ${ui>message} || ${ui>lastSyncInfo}}"/>
          </HBox>
          <SegmentedButton id="periodSelector" selectedKey="{ui>/period}" selectionChange=".onPeriodChange">
            <items>
              <SegmentedButtonItem key="1H" text="1h"/><SegmentedButtonItem key="24H" text="24h"/>
              <SegmentedButtonItem key="7D" text="7 days"/><SegmentedButtonItem key="30D" text="30 days"/>
            </items>
          </SegmentedButton>
          <Switch state="{ui>/autoRefresh}" change=".onAutoRefreshToggle" customTextOn="Auto" customTextOff="Off" tooltip="Auto-refresh every 30 s"/>
          <Button icon="sap-icon://refresh" tooltip="Refresh now" press=".onRefresh"/>
          <Button icon="sap-icon://download-from-cloud" text="Pull from Cloud ALM" type="Emphasized" press=".onSyncAll" busy="{ui>/syncing}"/>
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>

    <f:header>
      <f:DynamicPageHeader pinnable="true">
        <HBox wrap="Wrap" class="opsKpiBox">
          <GenericTile class="sapUiTinyMarginEnd sapUiTinyMarginBottom" header="Total failures" subheader="{ui>/periodText}" press=".onTilePress" frameType="OneByOne">
            <customData><core:CustomData key="source" value=""/></customData>
            <TileContent footer="IDocs + jobs"><NumericContent value="{ui>/overview/error}" icon="sap-icon://error" withMargin="false" valueColor="Error"/></TileContent>
          </GenericTile>
          <GenericTile class="sapUiTinyMarginEnd sapUiTinyMarginBottom" header="IDoc errors" subheader="{ui>/periodText}" press=".onTilePress" frameType="OneByOne">
            <customData><core:CustomData key="source" value="idoc"/></customData>
            <TileContent footer="Open IDoc Monitor"><NumericContent value="{ui>/overview/idocErrors}" icon="sap-icon://document" withMargin="false" valueColor="{= ${ui>/overview/idocErrors} > 0 ? 'Error' : 'Good'}"/></TileContent>
          </GenericTile>
          <GenericTile class="sapUiTinyMarginEnd sapUiTinyMarginBottom" header="Job failures" subheader="{ui>/periodText}" press=".onTilePress" frameType="OneByOne">
            <customData><core:CustomData key="source" value="job"/></customData>
            <TileContent footer="Open Job Monitor"><NumericContent value="{ui>/overview/jobErrors}" icon="sap-icon://batch-payments" withMargin="false" valueColor="{= ${ui>/overview/jobErrors} > 0 ? 'Error' : 'Good'}"/></TileContent>
          </GenericTile>
          <GenericTile class="sapUiTinyMarginEnd sapUiTinyMarginBottom" header="Successful" subheader="{ui>/periodText}" frameType="OneByOne">
            <TileContent footer="{ui>/overview/successRate}% success rate"><NumericContent value="{ui>/overview/success}" icon="sap-icon://sys-enter-2" withMargin="false" valueColor="Good"/></TileContent>
          </GenericTile>
          <GenericTile class="sapUiTinyMarginEnd sapUiTinyMarginBottom" header="Warnings" subheader="{ui>/periodText}" frameType="OneByOne">
            <TileContent footer="IDocs + jobs"><NumericContent value="{ui>/overview/warning}" icon="sap-icon://alert" withMargin="false" valueColor="Critical"/></TileContent>
          </GenericTile>
          <GenericTile class="sapUiTinyMarginEnd sapUiTinyMarginBottom" header="In Process" subheader="{ui>/periodText}" frameType="OneByOne">
            <TileContent footer="Waiting / running"><NumericContent value="{ui>/overview/inProcess}" icon="sap-icon://pending" withMargin="false" valueColor="Neutral"/></TileContent>
          </GenericTile>
        </HBox>
      </f:DynamicPageHeader>
    </f:header>

    <!-- Landing page = dashboard only. AI analysis and manual corrections live on the detail page
         of each failure (IDoc object page / Job run object page), opened from the failures table. -->
    <f:content>
      <VBox class="opsDashboard">
        <!-- Errors per SAP module: the module classifier agent (rules + AI) assigns every IDoc message type
             and job to a module; click a pie slice to filter the failure list. -->
        <VBox class="opsCard" busy="{ui>/modulesLoading}" busyIndicatorDelay="300">
          <HBox class="opsCardHeader" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
            <VBox>
              <Title text="Errors by SAP module" level="H4" wrapping="true" class="opsCardTitle"/>
              <Text text="Message types and jobs assigned to SD, MM, PP, QM, FI, CO, TM, EWM … by rules and AI · {ui>/periodText} · click a slice to filter the failures" class="opsCardSubtitle" wrapping="true"/>
            </VBox>
            <HBox alignItems="Center" class="opsModuleActions">
              <ObjectStatus text="{ui>/moduleAiCount} AI-classified" icon="sap-icon://ai" state="Information" visible="{= ${ui>/moduleAiCount} > 0}"
                tooltip="Categories assigned by the AI. Open 'Module mapping' to review or override." class="sapUiSmallMarginEnd"/>
              <Button text="Clear module filter" icon="sap-icon://clear-filter" type="Transparent" press=".onClearModuleFilter" visible="{= !!${ui>/moduleFilter}}"/>
              <Button text="Module mapping" icon="sap-icon://table-view" type="Transparent" press=".onOpenModuleMapping"/>
            </HBox>
          </HBox>
          <MessageStrip text="{ui>/moduleUnavailableText}" type="Warning" visible="{= !!${ui>/moduleUnavailableText}}" class="sapUiTinyMarginBottom"/>
          <FlexBox wrap="Wrap" alignItems="Stretch" class="opsModuleGrid">
            <VBox class="opsModulePane">
              <HBox alignItems="Center" justifyContent="SpaceBetween" class="opsModulePaneHeader">
                <ObjectStatus text="IDoc errors by module" state="None" class="opsPill opsPillIdoc"/>
                <ObjectStatus text="{ui>/moduleBreakdown/idocTotal}" state="Error" inverted="true"/>
              </HBox>
              <viz:VizFrame id="idocModuleChart" vizType="pie" uiConfig="{applicationSet:'fiori'}" height="300px" width="100%"
                selectData=".onModuleSelect" visible="{= ${ui>/idocModules}.length > 0}">
                <viz:customData><core:CustomData key="source" value="idoc"/></viz:customData>
                <viz:dataset>
                  <vizData:FlattenedDataset data="{ui>/idocModules}">
                    <vizData:dimensions><vizData:DimensionDefinition name="Module" value="{ui>label}"/></vizData:dimensions>
                    <vizData:measures><vizData:MeasureDefinition name="Errors" value="{ui>error}"/></vizData:measures>
                  </vizData:FlattenedDataset>
                </viz:dataset>
                <viz:feeds>
                  <vizFeeds:FeedItem uid="size" type="Measure" values="Errors"/>
                  <vizFeeds:FeedItem uid="color" type="Dimension" values="Module"/>
                </viz:feeds>
              </viz:VizFrame>
              <Text text="No IDoc errors in the selected period" visible="{= ${ui>/idocModules}.length === 0}" class="opsEmpty"/>
              <List items="{ui>/idocModules}" showSeparators="Inner" class="opsModuleList" visible="{= ${ui>/idocModules}.length > 0}">
                <CustomListItem type="Active" press=".onModuleItemPress">
                  <HBox alignItems="Center" class="opsModuleRow">
                    <core:Icon src="sap-icon://color-fill" color="{ui>color}" size="0.75rem" class="sapUiTinyMarginEnd"/>
                    <Text text="{ui>module}" class="opsModuleCode"/>
                    <VBox class="opsModuleRowText">
                      <Text text="{ui>moduleText}" class="opsModuleName"/>
                      <Text text="{ui>topCategories}" class="opsCardSubtitle" maxLines="1" tooltip="{ui>topCategories}"/>
                    </VBox>
                    <core:Icon src="sap-icon://ai" visible="{= ${ui>aiClassified} > 0}" tooltip="{ui>aiClassified} categor(ies) classified by AI" class="sapUiTinyMarginEnd opsAiIcon"/>
                    <ObjectStatus text="{ui>error}" state="Error"/>
                  </HBox>
                </CustomListItem>
              </List>
            </VBox>

            <VBox class="opsModulePane">
              <HBox alignItems="Center" justifyContent="SpaceBetween" class="opsModulePaneHeader">
                <ObjectStatus text="Job failures by module" state="None" class="opsPill opsPillJob"/>
                <ObjectStatus text="{ui>/moduleBreakdown/jobTotal}" state="Error" inverted="true"/>
              </HBox>
              <viz:VizFrame id="jobModuleChart" vizType="pie" uiConfig="{applicationSet:'fiori'}" height="300px" width="100%"
                selectData=".onModuleSelect" visible="{= ${ui>/jobModules}.length > 0}">
                <viz:customData><core:CustomData key="source" value="job"/></viz:customData>
                <viz:dataset>
                  <vizData:FlattenedDataset data="{ui>/jobModules}">
                    <vizData:dimensions><vizData:DimensionDefinition name="Module" value="{ui>label}"/></vizData:dimensions>
                    <vizData:measures><vizData:MeasureDefinition name="Errors" value="{ui>error}"/></vizData:measures>
                  </vizData:FlattenedDataset>
                </viz:dataset>
                <viz:feeds>
                  <vizFeeds:FeedItem uid="size" type="Measure" values="Errors"/>
                  <vizFeeds:FeedItem uid="color" type="Dimension" values="Module"/>
                </viz:feeds>
              </viz:VizFrame>
              <Text text="No job failures in the selected period" visible="{= ${ui>/jobModules}.length === 0}" class="opsEmpty"/>
              <List items="{ui>/jobModules}" showSeparators="Inner" class="opsModuleList" visible="{= ${ui>/jobModules}.length > 0}">
                <CustomListItem type="Active" press=".onModuleItemPress">
                  <HBox alignItems="Center" class="opsModuleRow">
                    <core:Icon src="sap-icon://color-fill" color="{ui>color}" size="0.75rem" class="sapUiTinyMarginEnd"/>
                    <Text text="{ui>module}" class="opsModuleCode"/>
                    <VBox class="opsModuleRowText">
                      <Text text="{ui>moduleText}" class="opsModuleName"/>
                      <Text text="{ui>topCategories}" class="opsCardSubtitle" maxLines="1" tooltip="{ui>topCategories}"/>
                    </VBox>
                    <core:Icon src="sap-icon://ai" visible="{= ${ui>aiClassified} > 0}" tooltip="{ui>aiClassified} categor(ies) classified by AI" class="sapUiTinyMarginEnd opsAiIcon"/>
                    <ObjectStatus text="{ui>error}" state="Error"/>
                  </HBox>
                </CustomListItem>
              </List>
            </VBox>
          </FlexBox>
        </VBox>

        <FlexBox wrap="Wrap" alignItems="Stretch" class="opsChartGrid">
          <VBox class="opsCard">
            <HBox class="opsCardHeader" alignItems="Center" justifyContent="SpaceBetween">
              <VBox>
                <Title text="Failures over time" level="H4" wrapping="true" class="opsCardTitle"/>
                <Text text="IDoc errors and job failures · {ui>/periodText}" class="opsCardSubtitle"/>
              </VBox>
              <ObjectStatus text="{ui>/overview/error}" state="Error" inverted="true" icon="sap-icon://error" tooltip="Total failures"/>
            </HBox>
            <viz:VizFrame id="trendChart" vizType="stacked_column" uiConfig="{applicationSet:'fiori'}" height="320px" width="100%">
              <viz:dataset>
                <vizData:FlattenedDataset data="{ui>/trend}">
                  <vizData:dimensions><vizData:DimensionDefinition name="Time" value="{ui>label}"/></vizData:dimensions>
                  <vizData:measures>
                    <vizData:MeasureDefinition name="IDoc errors" value="{ui>idocError}"/>
                    <vizData:MeasureDefinition name="Job failures" value="{ui>jobError}"/>
                  </vizData:measures>
                </vizData:FlattenedDataset>
              </viz:dataset>
              <viz:feeds>
                <vizFeeds:FeedItem uid="valueAxis" type="Measure" values="IDoc errors,Job failures"/>
                <vizFeeds:FeedItem uid="categoryAxis" type="Dimension" values="Time"/>
              </viz:feeds>
            </viz:VizFrame>
          </VBox>

          <VBox class="opsCard">
            <HBox class="opsCardHeader" alignItems="Center" justifyContent="SpaceBetween">
              <VBox>
                <Title text="By message type / job" level="H4" wrapping="true" class="opsCardTitle"/>
                <Text text="Top 15, failures first · hover a bar for the full name" class="opsCardSubtitle"/>
              </VBox>
            </HBox>
            <viz:VizFrame id="categoryChart" vizType="stacked_bar" uiConfig="{applicationSet:'fiori'}" height="320px" width="100%">
              <viz:dataset>
                <vizData:FlattenedDataset data="{ui>/categories}">
                  <vizData:dimensions><vizData:DimensionDefinition name="Category" value="{ui>label}"/></vizData:dimensions>
                  <vizData:measures>
                    <vizData:MeasureDefinition name="Success" value="{ui>success}"/>
                    <vizData:MeasureDefinition name="Warning" value="{ui>warning}"/>
                    <vizData:MeasureDefinition name="Error" value="{ui>error}"/>
                  </vizData:measures>
                </vizData:FlattenedDataset>
              </viz:dataset>
              <viz:feeds>
                <vizFeeds:FeedItem uid="valueAxis" type="Measure" values="Success,Warning,Error"/>
                <vizFeeds:FeedItem uid="categoryAxis" type="Dimension" values="Category"/>
              </viz:feeds>
            </viz:VizFrame>
          </VBox>
        </FlexBox>


        <VBox class="opsCard">
          <HBox class="opsCardHeader" alignItems="Center" justifyContent="SpaceBetween">
            <VBox>
              <Title text="Top errors" level="H4" wrapping="true" class="opsCardTitle"/>
              <Text text="Most frequent error reasons across both monitors · {ui>/periodText}" class="opsCardSubtitle"/>
            </VBox>
            <Text text="{= ${ui>/topErrors}.length } distinct errors" class="opsCardSubtitle"/>
          </HBox>
          <Table items="{ui>/topErrors}" noDataText="No failures in the selected period" growing="true" growingThreshold="5"
            growingTriggerText="Show more errors" class="opsTable">
            <columns>
              <Column width="8rem"><Text text="Source"/></Column>
              <Column width="30%" minScreenWidth="Tablet" demandPopin="true"><Text text="Message type / Job"/></Column>
              <Column><Text text="Error"/></Column>
              <Column width="6rem" hAlign="End"><Text text="Count"/></Column>
            </columns>
            <items>
              <ColumnListItem>
                <ObjectStatus text="{ui>sourceLabel}" state="None" class="{= ${ui>source} === 'idoc' ? 'opsPill opsPillIdoc' : 'opsPill opsPillJob'}"/>
                <Text text="{= ${ui>displayCategory} || ${ui>category} }" tooltip="{= ${ui>displayCategory} !== ${ui>category} ? 'Message type: ' + ${ui>category} : '' }" wrapping="true"/>
                <Text text="{ui>errorText}" wrapping="true" maxLines="2" tooltip="{ui>errorText}"/>
                <ObjectStatus text="{ui>count}" state="Error" inverted="true"/>
              </ColumnListItem>
            </items>
          </Table>
        </VBox>

        <VBox class="opsCard">
          <OverflowToolbar class="opsCardToolbar">
            <Title text="Failures ({ui>/failureCount})" level="H4" class="opsCardTitle"/>
            <Token text="Module: {ui>/moduleFilterText}" visible="{= !!${ui>/moduleFilter}}" delete=".onClearModuleFilter"/>
            <ToolbarSpacer/>
            <SegmentedButton selectedKey="{ui>/sourceFilter}" selectionChange=".onSourceFilter">
              <items>
                <SegmentedButtonItem key="" text="All"/><SegmentedButtonItem key="idoc" text="IDocs"/><SegmentedButtonItem key="job" text="Jobs"/>
              </items>
            </SegmentedButton>
            <SearchField width="16rem" liveChange=".onSearch" placeholder="Search object, error, system"/>
          </OverflowToolbar>
          <MessageStrip text="{ui>/unavailableText}" type="Warning" visible="{= !!${ui>/unavailableText}}" class="sapUiTinyMarginBottom"/>
          <Table id="failureTable" items="{ui>/failuresView}" noDataText="No failures in the selected period" growing="true" growingThreshold="25"
            sticky="ColumnHeaders" class="opsTable">
            <columns>
              <Column width="8rem"><Text text="Source"/></Column>
              <Column width="18rem"><Text text="Object"/></Column>
              <Column width="7rem" minScreenWidth="Tablet" demandPopin="true"><Text text="Module"/></Column>
              <Column width="10rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Type"/></Column>
              <Column><Text text="Error reason"/></Column>
              <Column width="13rem" minScreenWidth="Desktop" demandPopin="true"><Text text="System"/></Column>
              <Column width="12rem" minScreenWidth="Desktop" demandPopin="true"><Text text="Partner / Scheduled by"/></Column>
              <Column width="11rem" hAlign="End"><Text text="Time"/></Column>
            </columns>
            <items>
              <ColumnListItem type="Navigation" press=".onFailurePress" tooltip="Open details (AI analysis, manual corrections) in the source monitor">
                <ObjectStatus text="{ui>sourceLabel}" state="None" class="{= ${ui>source} === 'idoc' ? 'opsPill opsPillIdoc' : 'opsPill opsPillJob'}" tooltip="{ui>sourceLabel}"/>
                <Text text="{ui>objectId}" wrapping="true"/>
                <ObjectStatus text="{ui>module}" icon="{= ${ui>moduleBy} === 'AI' ? 'sap-icon://ai' : (${ui>moduleBy} === 'USER' ? 'sap-icon://person-placeholder' : '')}"
                  state="{= ${ui>module} === 'UNKNOWN' ? 'None' : 'Information'}"
                  tooltip="{ui>moduleText} · {= ${ui>moduleBy} === 'AI' ? 'classified by AI (' + ${ui>moduleConfidence} + '% confidence)' : (${ui>moduleBy} === 'USER' ? 'set manually' : (${ui>moduleBy} === 'RULE' ? 'rule' : 'not classified yet'))}"/>
                <Text text="{= ${ui>displayCategory} || ${ui>category} }" tooltip="{= ${ui>displayCategory} !== ${ui>category} ? 'Message type: ' + ${ui>category} : '' }" wrapping="true"/>
                <Text text="{ui>errorText}" wrapping="true" maxLines="3"/>
                <Text text="{ui>system}" wrapping="true" class="opsBreakAll"/>
                <Text text="{ui>partner}" wrapping="true"/>
                <Text text="{ui>timeText}" wrapping="true"/>
              </ColumnListItem>
            </items>
          </Table>
        </VBox>
      </VBox>
    </f:content>
  </f:DynamicPage>
</mvc:View>
